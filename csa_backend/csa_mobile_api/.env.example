# Copy to .env and fill in. .env is gitignored.

# ---- Core ----
# DEBUG now DEFAULTS TO False. Only set this to True on a local dev box.
DEBUG=True
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# ---- Database (runtime role: mobile_api_user) ----
DB_NAME=csa_db
DB_USER=mobile_api_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- SMS OTP (Rancard) ----
# Was previously hardcoded in accounts/views.py — rotate the old key.
# If left blank, SMS OTP is skipped and email OTP is used.
RANCARD_SMS_API_KEY=
RANCARD_SMS_SENDER_ID=MobApp-CSA

# ---- Firebase (push) ----
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Cache (login/OTP throttles) ----
# Optional. Defaults to a .django_cache/ dir next to manage.py.
# CACHE_DIR=/var/cache/csa_mobile

# ---- Email (SMTP) ----
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
