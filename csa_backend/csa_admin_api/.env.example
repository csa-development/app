# Copy to .env and fill in. .env is gitignored.

# ---- Core ----
# DEBUG now DEFAULTS TO False. Only set this to True on a local dev box.
DEBUG=True
# Must be DIFFERENT from csa_mobile_api's SECRET_KEY.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Database (runtime role: admin_api_user) ----
DB_NAME=csa_db
DB_USER=admin_api_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Firebase (push) ----
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Cache (admin-login brute-force throttle) ----
# Optional. Defaults to a .django_cache/ dir next to manage.py.
# CACHE_DIR=/var/cache/csa_admin
